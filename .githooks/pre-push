#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
remote_name="${1:-origin}"
input_file="$(mktemp "${TMPDIR:-/tmp}/sicily-privacy-push.XXXXXX")"
trap 'rm -f "$input_file"' EXIT HUP INT TERM
cat >"$input_file"

python3 "$repo_root/scripts/privacy_scan.py" --pre-push "$remote_name" <"$input_file"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact "$repo_root"
fi
